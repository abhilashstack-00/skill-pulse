{
  "name": "skillpulse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "data:generate": "tsx scripts/pilot/generate-raw.ts",
    "data:ingest": "tsx scripts/ingest.ts",
    "data:build": "pnpm data:generate && pnpm data:ingest",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/db-setup.ts",
    "pipeline": "tsx --env-file-if-exists=.env.local scripts/pipeline.ts",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest-file.ts",
    "e2e": "node scripts/e2e.mjs",
    "demo:users": "tsx --env-file-if-exists=.env.local scripts/create-demo-users.ts",
    "demo:evaluator": "tsx --env-file-if-exists=.env.local scripts/create-evaluator-account.ts",
    "verify:supabase": "tsx --env-file-if-exists=.env.local scripts/verify-supabase.ts",
    "db:check-rls": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -q -f supabase/tests/rls-check.sql"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@svg-maps/india": "2.0.0",
    "@vercel/analytics": "1.6.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "pg": "^8.23.1",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vitest": "^5.0.3"
  }
}

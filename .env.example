# SkillPulse environment. Copy to .env.local and fill in what you need.
# With nothing set, `pnpm dev` runs on the bundled pilot dataset with a demo role switch.

# A production build (`pnpm start`) refuses to serve data without sign-in unless this is set.
# Demo mode has no users: anyone can pick any role.
DEMO_MODE=
# Demo mode cannot change stored data (there is no user to hold responsible). Set to "on" only
# with a throw-away database, to try loading files through the app without setting up sign-in.
DEMO_WRITES=

# --- Data -------------------------------------------------------------------
# Direct PostgreSQL connection (Supabase → Project settings → Database → Connection string → URI).
# Server only. When set, the app and the scripts read and write this database.
DATABASE_URL=

# A remote database connection is encrypted and VERIFIED. Supabase signs with its own
# certificate authority, so set one of these two:
#   DATABASE_CA_CERT  path to the CA certificate (Supabase → Database settings → SSL configuration)
#   DATABASE_SSL=no-verify   encrypted but not verified; for a quick demo only
DATABASE_CA_CERT=
DATABASE_SSL=

# --- Supabase Auth ----------------------------------------------------------
# Setting both of these turns sign-in on: every page then needs a signed-in user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only, never exposed to the browser. Use Supabase's current secret key
# (SUPABASE_SECRET_KEY); SUPABASE_SERVICE_ROLE_KEY remains supported for legacy keys.
# Reads a user's role from public.profiles and, when DATABASE_URL is not set,
# reads the data tables through the REST API.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Tuning -----------------------------------------------------------------
# Seconds a computed snapshot is reused before the data is read again (default 300).
SNAPSHOT_TTL_SECONDS=300
# API requests allowed per client per minute, per server instance (default 300).
RATE_LIMIT_PER_MINUTE=300

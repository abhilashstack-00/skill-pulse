# SkillPulse environment. Copy to .env.local and fill in what you need.
# With nothing set, the app runs on the bundled pilot dataset with a demo role switch.

# --- Data -------------------------------------------------------------------
# Direct PostgreSQL connection (Supabase → Project settings → Database → Connection string → URI).
# Server only. When set, the app and the scripts read and write this database.
DATABASE_URL=

# Optional: path to the Supabase CA certificate (Database settings → SSL configuration).
# When set, the database connection is verified against it. Without it the connection
# is encrypted but the server certificate is not verified.
DATABASE_CA_CERT=

# --- Supabase Auth ----------------------------------------------------------
# Setting both of these turns sign-in on: every page then needs a signed-in user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only, never exposed to the browser. Reads a user's role from public.profiles
# and, when DATABASE_URL is not set, reads the data tables through the REST API.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tuning -----------------------------------------------------------------
# Seconds a computed snapshot is reused before the data is read again (default 300).
SNAPSHOT_TTL_SECONDS=300
